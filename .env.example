# ─────────────────────────────────────────────────────────────
# GraveSigns environment variables
# Copy this file to .env.local and fill in the values.
# The app runs in "demo mode" without Supabase (readings are still
# calculated and composed, just not stored).
# ─────────────────────────────────────────────────────────────

# Anthropic (Claude) — REQUIRED to generate readings
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the reading model (defaults to claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5

# Supabase — optional (enables saving & viewing previous readings)
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used by API routes to write readings
# with row-level security enabled. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
