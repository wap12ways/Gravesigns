# ─────────────────────────────────────────────────────────────
# Alpha Environmental — OregonBuys bid estimator
# Copy to .env.local for local dev; set the same keys in Vercel
# (Project → Settings → Environment Variables) for deploys.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → Data API / API Keys
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Every database and storage call in this app runs server side with this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret the Vercel cron job sends as `Authorization: Bearer <CRON_SECRET>`.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-me

# Single password gate for the whole app (no user accounts in the prototype).
APP_PASSWORD=change-me

# Secret used to sign the login session cookie. Any long random string.
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me
