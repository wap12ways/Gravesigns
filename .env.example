# ─────────────────────────────────────────────────────────────
# GraveSigns environment variables
# Copy this file to .env.local and fill in the values.
# The app runs in "demo mode" without Supabase (readings are still
# calculated and composed, just not stored).
# ─────────────────────────────────────────────────────────────

# Anthropic (Claude) — REQUIRED to generate readings
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Models ───────────────────────────────────────────────────
# The reading runs five Claude passes. Every pass defaults to Opus 4.8
# (the "showcase" profile). ANTHROPIC_MODEL overrides the default for ALL
# passes at once; the per-pass vars below override individual passes and win
# over ANTHROPIC_MODEL. Both ethics and verification REWRITES always run on the
# composition model, so the finished reading stays at composition grade no
# matter how cheaply the audits are tiered.
#
# Model IDs: claude-opus-4-8  ·  claude-sonnet-5  ·  claude-haiku-4-5
#
# ANTHROPIC_MODEL=claude-opus-4-8
#
# A cost/latency-tiered profile (uncomment to use instead of all-Opus):
# ANTHROPIC_MODEL_JUDGMENT=claude-sonnet-5      # Pass A — weigh the evidence
# ANTHROPIC_MODEL_COMPOSITION=claude-opus-4-8   # Pass B — the reading (+ all rewrites)
# ANTHROPIC_MODEL_ETHICS=claude-haiku-4-5       # Pass E — ethical-alignment audit
# ANTHROPIC_MODEL_VERIFICATION=claude-haiku-4-5 # Pass C — fabrication audit
# ANTHROPIC_MODEL_STUDY_NOTES=claude-sonnet-5   # Pass N — the practitioner's notebook

# Supabase — optional (enables saving & viewing previous readings)
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, used by API routes to write readings
# with row-level security enabled. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
